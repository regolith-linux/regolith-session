[Unit]
Description=Regolith Session for i3
# On X11, show the GNOME Session Failed screen where gnome-session still has
# one, otherwise end the session (see regolith-x11-failed.service)
OnFailure=regolith-x11-failed.service
OnFailureJobMode=replace
CollectMode=inactive-or-failed
RefuseManualStart=on
RefuseManualStop=on

After=gnome-session-manager.target

Requisite=gnome-session-initialized.target
PartOf=gnome-session-initialized.target
Before=gnome-session-initialized.target

PartOf=regolith-x11.target
BindsTo=regolith-x11.target
After=regolith-x11.target

ConditionEnvironment=XDG_SESSION_TYPE=x11

# Limit startup frequency more than the default
StartLimitIntervalSec=15s
StartLimitBurst=3

[Service]
Slice=session.slice
Type=notify
NotifyAccess=all
ExecStart=regolith-session-x11

# Setup custom environment for session
EnvironmentFile=-%h/.config/regolith3/i3/env

# On X11 we do not need to unset any variables

# On X11 we want to restart on-success and on-failure.
Restart=always
# Restart without passing through the failed state, so OnFailure= only runs
# once the start limit is hit (systemd 254 and newer)
RestartMode=direct
# Do not wait before restarting the shell
RestartSec=0ms
# Kill any stubborn child processes after this long
TimeoutStopSec=5

# Lower down gnome-shell's OOM score to avoid being killed by OOM-killer too early
OOMScoreAdjust=-1000
