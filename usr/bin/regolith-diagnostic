#!/bin/bash
# Prints diagnostic info related to Regolith for troubleshooting purposes

set -Eeu -o pipefail

source /usr/lib/regolith/regolith-session-common.sh

print_file() {
  if [ -f "$1" ]; then
    echo "--- $1:"
    cat "$1"
  else
    echo "--- [$1 does not exist]"
  fi
}

# Print a settings file of one of the layers, if it counts
print_settings_file() {
  if is_settings_file "$1"; then
    echo "--- $1:"
    cat "$1"
    # Start the next header on a line of its own
    if [ -n "$(tail -c 1 "$1")" ]; then
      echo
    fi
  fi
}

# Print the settings files of the administrators, the weakest first, and of
# the user, under <name> in their directories
print_layer_files() { # print_layer_files <name>
  local file
  while IFS= read -r file; do
    print_settings_file "$file"
  done < <(layer_settings_files "$1")
}

# Print a window manager's configuration files, from the weakest to the
# strongest, its session environment files, and the configuration a new
# session would start it with
print_wm_files() { # print_wm_files <i3|sway> <shipped config>
  print_file "$2"
  print_layer_files "$1/config"
  ls -l "/usr/share/regolith/$1/config.d/" || true
  echo "--- $1 session environment"
  print_layer_files "$1/env"
  resolve_wm_config_file "$1" "$2"
  echo "effective $1 config: $WM_CONFIG_FILE"
}

print_settings() {
  gsettings list-recursively "$1" 2>/dev/null || echo "--- [schema $1 is not installed]"
}

# Which window manager to describe: the one of the session this runs in. From
# a text console or ssh there is none, so describe each installed Regolith
# session, and i3 (as before) when neither session file is found.
X11_SESSION=/usr/share/xsessions/regolith-x11.desktop
WAYLAND_SESSION=/usr/share/wayland-sessions/regolith-wayland.desktop
report_i3=false
report_sway=false
case "${XDG_SESSION_TYPE-}" in
  wayland) report_sway=true ;;
  x11) report_i3=true ;;
  *)
    if [ -f "$X11_SESSION" ]; then report_i3=true; fi
    if [ -f "$WAYLAND_SESSION" ]; then report_sway=true; fi
    if ! $report_i3 && ! $report_sway; then report_i3=true; fi
    ;;
esac

echo "--- Regolith Diagnostic - $(date)"
print_file /etc/regolith/version
echo "XDG_SESSION_TYPE=${XDG_SESSION_TYPE-}"
echo "DESKTOP_SESSION=${DESKTOP_SESSION-}"
installed=""
for session in "$X11_SESSION" "$WAYLAND_SESSION"; do
  if [ -f "$session" ]; then installed="$installed $(basename "$session" .desktop)"; fi
done
echo "Installed sessions:${installed:- none}"

echo "--- System Info "
uname -a

print_file /etc/lsb-release

# The look in use, as the session resolves it from the resource database.
# From a text console or ssh there may be no database to ask.
if "$RESOURCE_GETTER" regolith.look.path "" >/dev/null 2>&1; then
  resolve_look_path "$RESOURCE_GETTER"
else
  LOOK_STYLE_ROOT_PATH="" LOOK_STYLE_ROOT_FILE=""
fi

# The resource sources, from the weakest to the strongest
echo "--- Xresources"
while IFS= read -r file; do
  print_settings_file "$file"
done < <(system_xres_files)
print_settings_file "$BASELINE_XRESOURCE_FILE"
print_settings_file "$LOOK_STYLE_ROOT_FILE"
print_layer_files Xresources
print_file "$HOME/.cache/regolith3/Xresources-generated"

if $report_sway; then
  trawldb -q || true
  echo # trawldb does not end its output with a newline
fi
if $report_i3; then
  xrdb -query || true
fi
echo "effective look: ${LOOK_STYLE_ROOT_PATH:-[no resource database to read regolith.look.path from]}"

if $report_sway; then
  echo "--- sway"
  sway --version || true
  print_wm_files sway "$DEFAULT_SYS_SWAY_CONFIG_FILE"
fi
if $report_i3; then
  echo "--- i3"
  i3 --moreversion || true
  print_wm_files i3 "$DEFAULT_SYS_I3_CONFIG_FILE"
fi

if [ -d "/usr/share/i3xrocks" ]; then
  echo "--- i3xrocks config"
  find /usr/share/i3xrocks
else
  echo "--- [/usr/share/i3xrocks does not exist]"
fi

echo "--- dconf"
print_settings org.gnome.desktop.interface
print_settings org.gnome.desktop.background
if $report_i3; then
  print_settings org.gnome.gnome-flashback
fi
print_settings org.regolith-linux.ilia
print_settings org.gnome.desktop.wm.keybindings
print_settings org.gnome.settings-daemon.plugins.media-keys
print_settings org.gnome.desktop.wm.preferences

