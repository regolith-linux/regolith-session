#!/bin/bash
# This is a helper script to perform common tasks with regolith looks.

set -Eeu -o pipefail

# Load common functions
source /usr/lib/regolith/regolith-session-common.sh

if [ "$#" -lt 1 ]; then
    echo "Usage: regolith-look <command>"
    echo "Actions: "
    echo "    refresh - Update the current session look based on Xresources values"
    echo "    list - Display currently installed looks in the /usr/share/regolith-look directory"
    echo "    set <look> - Write a global override file in the user dir to specify the desired look"
    echo "    separate-gnome [--dry-run] - Move the look's settings that earlier Regolith sessions left in"
    echo "        the settings GNOME and other desktops share into Regolith's own settings"
    exit 1
fi

COMMAND=$1

WM_RELOAD="i3-msg -q restart"

# sway's reload applies default_border, default_floating_border and the gaps
# only to windows and workspaces created afterwards, while i3's restart applies
# them to the open ones too. Give the open windows and workspaces what a new
# one gets from Regolith's sway config: the default borders, the border its
# for_window rule sets on every window, and the gaps. sway expands the config's
# variables in these commands. A command that matches no window, or whose
# variables the config doesn't set, fails and is skipped.
sway_restyle_existing() {
    local cmd
    for cmd in \
        '[tiling] border $wm.window.border.style $wm.window.border.size' \
        '[floating] border $wm.floatingwindow.border.style $wm.floatingwindow.border.size' \
        '[title=".*"] border pixel $wm.window.border.size' \
        'gaps inner all set $wm.gaps.inner.size' \
        'gaps outer all set $wm.gaps.outer.size'; do
        swaymsg -q "$cmd" >/dev/null 2>&1 || true
    done
}

refresh() {
    # The look's settings go to the Regolith sessions only, also from outside one
    use_regolith_settings --outside-session

    if [[ ${XDG_SESSION_TYPE-} == "wayland" ]]; then
        WM_RELOAD="swaymsg reload"
        reload_sway_resources
        swaymsg -t send_tick '{"status": "reload_pending"}'
    else
        reload_i3_resources
    fi

    # Determine if Look loader script is available
    LOADER_PATH="$($RESOURCE_GETTER regolith.look.loader)"
    if [ -n  "$LOADER_PATH" ]; then
        # Load the look-specific script that has a function called load_look()
        source "$LOADER_PATH"
        # Call look function to update UI
        skip_locked_settings load_look

        # restart window manager after merging Xresources
        $WM_RELOAD
        if [[ ${XDG_SESSION_TYPE-} == "wayland" ]]; then
            sway_restyle_existing
        fi
    else
        echo "No look loader script specified, no UI changes"
    fi
}

# The resources a login loads, for the look's loader. Where none are loaded,
# as from another desktop or once a Wayland session has ended, load them from
# the files as a login does. An X server of another desktop gets its own
# resources back afterwards, from <saved>: see restore_x_resources.
# ensure_look_resources <saved>
ensure_look_resources() {
    if [ -n "$($RESOURCE_GETTER regolith.look.loader 2>/dev/null || :)" ]; then
        return 0
    fi
    if [[ ${XDG_SESSION_TYPE-} == "wayland" ]]; then
        reload_sway_resources
    else
        xrdb -query > "$1"
        clear_xres
        load_standard_xres
        load_regolith_xres
        xres_i3_cleanup
    fi
}

# restore_x_resources <saved>: put back the X resources ensure_look_resources
# replaced, if it did
restore_x_resources() {
    [ -f "$1" ] || return 0
    if [ -s "$1" ]; then
        xrdb -nocpp -load "$1"
    else
        xrdb -remove
    fi
}

# Print "<schema> <key> <value>" for each setting the look's loader writes
# given the resources, the value as gsettings prints it. The loader runs with
# its settings going to a scratch key file instead of dconf, and the programs
# it runs find a dconf command that changes nothing (the default loader's
# gnome-terminal profile is written with dconf).
look_settings() {
    local loader
    loader="$($RESOURCE_GETTER regolith.look.loader 2>/dev/null || :)"
    [ -n "$loader" ] || return 0
    (
        scratch=$(mktemp -d)
        # What the loader prints is shown only if it fails
        # shellcheck disable=SC2329 # the trap runs it
        end_look_settings() {
            local status=$?
            [ "$status" -eq 0 ] || cat "$scratch/loader.log" >&2
            rm -rf "$scratch"
        }
        trap end_look_settings EXIT
        export GSETTINGS_BACKEND=keyfile XDG_CONFIG_HOME="$scratch"
        mkdir "$scratch/bin"
        printf '#!/bin/sh\nexit 0\n' > "$scratch/bin/dconf"
        chmod +x "$scratch/bin/dconf"
        export PATH="$scratch/bin:$PATH"
        gsettings() {
            if [ "${1-}" == "set" ]; then
                printf '%s %s\n' "$2" "$3" >> "$scratch/written"
            fi
            command gsettings "$@"
        }
        source "$loader"
        load_look > "$scratch/loader.log" 2>&1
        if [ -f "$scratch/written" ]; then
            awk '!seen[$0]++' "$scratch/written" | while read -r schema key; do
                echo "$schema $key $(command gsettings get "$schema" "$key")"
            done
        fi
    )
}

# Sessions before Regolith had settings of its own wrote the look's settings
# into the user's own settings, which the user's other desktops read too. Move
# those still holding what Regolith writes into Regolith's settings: each key
# the look's loader writes, given the resources, and the text scaling factor
# set from the user's Xft.dpi. Keys holding anything else stay as they are.
separate_gnome() {
    local dry_run=false arg schema key value path raw paths settings moved=""
    for arg in "$@"; do
        case $arg in
            --dry-run) dry_run=true ;;
            *)
                echo "Unrecognized option: $arg" >&2
                echo "Usage: regolith-look separate-gnome [--dry-run]" >&2
                exit 2 ;;
        esac
    done

    use_regolith_settings --outside-session
    if [ -z "$REGOLITH_SETTINGS_DB" ]; then
        echo "Aborting, the Regolith sessions have no settings of their own with this dconf profile" >&2
        exit 1
    fi

    scratch=$(mktemp -d)
    trap 'restore_x_resources "$scratch/xresources" || :; rm -rf "$scratch"' EXIT
    ensure_look_resources "$scratch/xresources" >&2
    settings=$(look_settings)
    restore_x_resources "$scratch/xresources"
    rm -f "$scratch/xresources"

    # The user's own database, and Regolith's, without the databases below
    # them: the values they hold, regardless of administrator defaults and locks
    echo "user-db:$PLAIN_SETTINGS_DB" > "$scratch/plain"
    echo "user-db:$REGOLITH_SETTINGS_DB" > "$scratch/regolith"
    paths=$(gsettings list-schemas --print-paths)

    # A value the user already set in a Regolith session stays: the key only
    # leaves the user's own settings
    move_setting() { # move_setting <schema> <key> <path> <value>
        moved+="$1 $2"$'\n'
        echo "$1 $2"
        if ! $dry_run; then
            if [ -z "$(DCONF_PROFILE="$scratch/regolith" dconf read "$3")" ]; then
                DCONF_PROFILE="$scratch/regolith" dconf write "$3" "$4"
            fi
            DCONF_PROFILE="$scratch/plain" dconf reset "$3"
        fi
    }

    while read -r schema key value; do
        [ -n "$schema" ] || continue
        path=$(awk -v schema="$schema" '$1 == schema { print $2; exit }' <<< "$paths")
        [ -n "$path" ] || continue
        raw=$(DCONF_PROFILE="$scratch/plain" dconf read "$path$key")
        if [ -n "$raw" ] \
           && [ "$(DCONF_PROFILE="$scratch/plain" gsettings get "$schema" "$key")" == "$value" ]; then
            move_setting "$schema" "$key" "$path$key" "$raw"
        fi
    done <<< "$settings"

    # The factor apply_user_xft_dpi set last
    schema=org.gnome.desktop.interface key=text-scaling-factor
    path=/org/gnome/desktop/interface/$key
    if [ -f "$XFT_DPI_STATE_FILE" ] && ! grep -qxF "$schema $key" <<< "$moved"; then
        raw=$(DCONF_PROFILE="$scratch/plain" dconf read "$path")
        if [ -n "$raw" ] && same_number "$raw" "$(cat "$XFT_DPI_STATE_FILE")"; then
            move_setting "$schema" "$key" "$path" "$raw"
        fi
    fi
}

# Upsert Xresource key regolith.look.path and refresh session
set_look() {
    if [ ! -d "$LOOK_PATH" ]; then
        echo "Aborting, invalid look directory: $LOOK_PATH"
        exit 1
    fi

    # Unset any existing values
    if [ -e "$USER_XRESOURCE_OVERRIDE_FILE" ]; then
	# remove existing declaration comments
        sed -i '/^!regolith.look.path/d' "$USER_XRESOURCE_OVERRIDE_FILE"

        # disable existing declaration
        sed -i 's/^regolith.look.path/\!regolith.look.path/g' "$USER_XRESOURCE_OVERRIDE_FILE"
    fi

    # add new declaration
    echo "regolith.look.path: $LOOK_PATH" >> "$USER_XRESOURCE_OVERRIDE_FILE"

    # refresh rebuilds the resources from the files, so it reads the new look
    refresh
}

if [ "$COMMAND" == "refresh" ]; then
    refresh
elif [ "$COMMAND" == "set" ]; then
    LOOK_NAME=${2-}
    if [ -z "$LOOK_NAME" ]; then
        echo "Must specify a look to set." >&2
        exit 1
    else
        LOOK_PATH="$DEFAULT_LOOK_ROOT/$LOOK_NAME"

        if [ -d "$LOOK_PATH" ]; then
            set_look
        else
            LOOK_PATH="$USER_LOOK_ROOT/$LOOK_NAME"
            if [ -d "$LOOK_PATH" ]; then
                set_look
            else
                echo "Unable to find look $LOOK_NAME in $DEFAULT_LOOK_ROOT or $USER_LOOK_ROOT" >&2
                echo "Run 'regolith-look list' to see the installed looks." >&2
                exit 1
            fi
        fi
    fi
elif [ "$COMMAND" == "separate-gnome" ]; then
    separate_gnome "${@:2}"
elif [ "$COMMAND" == "list" ]; then
    if [ -d "$USER_LOOK_ROOT" ]; then
        find {"$DEFAULT_LOOK_ROOT","$USER_LOOK_ROOT"} -maxdepth 1 -mindepth 1 -type d -printf '%f\n' | sort
    else
        find "$DEFAULT_LOOK_ROOT" -maxdepth 1 -mindepth 1 -type d -printf '%f\n' | sort
    fi
else
    echo "Unrecognized command: $COMMAND"
    exit 1
fi
