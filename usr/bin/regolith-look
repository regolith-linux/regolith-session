#!/bin/bash
# This is a helper script to perform common tasks with regolith looks.

set -Eeu -o pipefail

# Load common functions
source /usr/lib/regolith/regolith-session-common.sh

if [ "$#" -lt 1 ]; then
    echo "Usage: regolith-look <command>"
    echo "Actions: "
    echo "    refresh - Update the current session look based on Xresources values"
    echo "    list - Display the looks installed in /usr/share/regolith-look and in the looks directories of the administrators and the user"
    echo "    set <look> - Write a global override file in the user dir to specify the desired look"
    exit 1
fi

COMMAND=$1

# The looks directories, in the order 'set' looks a name up in: the user's,
# the administrators', the most important first, then the shipped looks
LOOK_ROOTS=("$USER_LOOK_ROOT")
for dir in "${SYSTEM_CONFIG_DIRS[@]}"; do
    LOOK_ROOTS+=("$dir/looks")
done
LOOK_ROOTS+=("$DEFAULT_LOOK_ROOT")

WM_RELOAD="i3-msg -q restart"

# sway's reload applies default_border, default_floating_border and the gaps
# only to windows and workspaces created afterwards, while i3's restart applies
# them to the open ones too. Give the open windows and workspaces what a new
# one gets from Regolith's sway config: the default borders, the border its
# for_window rule sets on every window, and the gaps. sway expands the config's
# variables in these commands. A command that matches no window, or whose
# variables the config doesn't set, fails and is skipped.
sway_restyle_existing() {
    local cmd
    for cmd in \
        '[tiling] border $wm.window.border.style $wm.window.border.size' \
        '[floating] border $wm.floatingwindow.border.style $wm.floatingwindow.border.size' \
        '[title=".*"] border pixel $wm.window.border.size' \
        'gaps inner all set $wm.gaps.inner.size' \
        'gaps outer all set $wm.gaps.outer.size'; do
        swaymsg -q "$cmd" >/dev/null 2>&1 || true
    done
}

refresh() {
    if [[ ${XDG_SESSION_TYPE-} == "wayland" ]]; then
        WM_RELOAD="swaymsg reload"
        reload_sway_resources
        swaymsg -t send_tick '{"status": "reload_pending"}'
    else
        reload_i3_resources
    fi

    # Determine if Look loader script is available
    # A look without a loader script (a user's own, for one) has no such
    # resource: the empty default then leaves LOADER_PATH empty. A loader
    # that is not a settings file is passed over too.
    LOADER_PATH="$($RESOURCE_GETTER regolith.look.loader "")"
    if is_settings_file "$LOADER_PATH"; then
        # Load the look-specific script that has a function called load_look()
        source "$LOADER_PATH"
        # Call look function to update UI
        load_look

        # restart window manager after merging Xresources, unless the
        # configuration file it started with is gone
        if wm_config_present; then
            $WM_RELOAD
            if [[ ${XDG_SESSION_TYPE-} == "wayland" ]]; then
                sway_restyle_existing
            fi
        else
            echo "The window manager's configuration file is gone, not reloading it until the next login" >&2
        fi
    else
        echo "No look loader script specified, no UI changes"
    fi
}

# Upsert Xresource key regolith.look.path and refresh session
set_look() {
    if [ ! -d "$LOOK_PATH" ]; then
        echo "Aborting, invalid look directory: $LOOK_PATH" >&2
        exit 1
    fi

    mkdir -p "$USER_CONFIG_DIR"

    # Unset any existing values. The file may be a link to the user's own
    # file: edit that file and keep the link.
    if [ -e "$USER_XRESOURCE_OVERRIDE_FILE" ]; then
        # remove existing declaration comments
        sed -i --follow-symlinks '/^!regolith\.look\.path/d' "$USER_XRESOURCE_OVERRIDE_FILE"

        # disable existing declarations
        sed -i --follow-symlinks 's/^\([[:space:]]*regolith\.look\.path[[:space:]]*:\)/!\1/' "$USER_XRESOURCE_OVERRIDE_FILE"

        # The new declaration goes on a line of its own
        if [ -n "$(tail -c 1 "$USER_XRESOURCE_OVERRIDE_FILE")" ]; then
            echo >> "$USER_XRESOURCE_OVERRIDE_FILE"
        fi
    fi

    # add new declaration
    printf 'regolith.look.path: %s\n' "$LOOK_PATH" >> "$USER_XRESOURCE_OVERRIDE_FILE"

    # refresh rebuilds the resources from the files, so it reads the new look
    refresh
}

# Print the name of every look once, in byte order
list_looks() {
    local root dir
    for root in "${LOOK_ROOTS[@]}"; do
        for dir in "$root"/*/ "$root"/.[!.]*/ "$root"/..?*/; do
            [ -d "$dir" ] || continue
            dir=${dir%/}
            printf '%s\n' "${dir##*/}"
        done
    done | LC_ALL=C sort -u
}

if [ "$COMMAND" == "refresh" ]; then
    refresh
elif [ "$COMMAND" == "set" ]; then
    LOOK_NAME=${2-}
    if [ -z "$LOOK_NAME" ]; then
        echo "Must specify a look to set." >&2
        exit 1
    fi
    case $LOOK_NAME in
        */* | . | ..)
            echo "Invalid look name: $LOOK_NAME" >&2
            echo "Run 'regolith-look list' to see the installed looks." >&2
            exit 1 ;;
    esac

    # The first directory with that name, in the order of LOOK_ROOTS
    for root in "${LOOK_ROOTS[@]}"; do
        if [ -d "$root/$LOOK_NAME" ]; then
            LOOK_PATH="$root/$LOOK_NAME"
            set_look
            exit 0
        fi
    done

    searched="$DEFAULT_LOOK_ROOT or $USER_LOOK_ROOT"
    for dir in "${SYSTEM_CONFIG_DIRS[@]}"; do
        searched+=" or $dir/looks"
    done
    echo "Unable to find look $LOOK_NAME in $searched" >&2
    echo "Run 'regolith-look list' to see the installed looks." >&2
    exit 1
elif [ "$COMMAND" == "list" ]; then
    list_looks
else
    echo "Unrecognized command: $COMMAND"
    exit 1
fi
